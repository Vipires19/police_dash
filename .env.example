# Copie este arquivo para `.env` na raiz do repositório e ajuste os valores.
# O arquivo `.env` real NÃO deve ser versionado (já está no .gitignore).

# Chave secreta para assinatura JWT (use valor longo e aleatório em produção).
SECRET_KEY=altere-esta-chave-use-openssl-rand-hex-32-ou-similar

# URL do PostgreSQL para o backend (driver psycopg v3).
# Exemplo local:
DATABASE_URL=postgresql+psycopg://pelotao:pelotao@localhost:5432/pelotao
# No Docker Compose, o serviço `backend` sobrescreve com DATABASE_URL apontando para o host `db`.

# Origens permitidas no CORS (lista separada por vírgula, sem espaços extras).
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:80

# Bootstrap opcional: se ambos estiverem preenchidos, cria um usuário ADMIN aprovado
# na subida da API (somente se o e-mail ainda não existir).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PATENTE=SD
ADMIN_NOME_GUERRA=Admin

# Frontend (Vite) — use em desenvolvimento local; no build Docker usa build-arg VITE_API_URL.
# VITE_API_URL=http://localhost:8000
